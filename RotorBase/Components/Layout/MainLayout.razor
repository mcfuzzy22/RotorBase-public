@inherits LayoutComponentBase
@inject UserSession Session
@inject NavigationManager Nav

<div class="relative min-h-dvh overflow-x-hidden bg-background text-foreground">
    <header class="sticky top-0 z-40 border-b border-border/60 bg-surface">
        <div class="container flex h-16 items-center justify-between gap-4">
            <NavLink class="inline-flex items-center gap-2 text-sm font-semibold" href="/" Match="NavLinkMatch.All" ActiveClass="">
                <span class="inline-flex size-2.5 rounded-full bg-primary"></span>
                <span>BoostedRotary.com</span>
            </NavLink>

            <nav class="hidden items-center rounded-md bg-muted p-1 text-sm font-medium text-foreground/70 md:flex" aria-label="Primary navigation">
                <NavLink href="/" Match="NavLinkMatch.All" class="rounded px-3 py-1.5 transition-colors hover:text-foreground" ActiveClass="bg-surface text-foreground shadow-sm">
                    Home
                </NavLink>
                <NavLink href="/picker" class="rounded px-3 py-1.5 transition-colors hover:text-foreground" ActiveClass="bg-surface text-foreground shadow-sm">
                    Picker
                </NavLink>
                <NavLink href="/shop" class="rounded px-3 py-1.5 transition-colors hover:text-foreground" ActiveClass="bg-surface text-foreground shadow-sm">
                    Shop
                </NavLink>
                <NavLink href="/builds" class="rounded px-3 py-1.5 transition-colors hover:text-foreground" ActiveClass="bg-surface text-foreground shadow-sm">
                    Builds
                </NavLink>
                <NavLink href="/builder" class="rounded px-3 py-1.5 transition-colors hover:text-foreground" ActiveClass="bg-surface text-foreground shadow-sm">
                    Builder
                </NavLink>
            </nav>

            <div class="flex items-center gap-3">
                <MobileMenu />
                @if (Session.IsSignedIn)
                {
                    <GamChip />
                    <span class="hidden text-sm font-medium text-foreground/80 sm:inline">
                        @(!string.IsNullOrWhiteSpace(Session.DisplayName) ? Session.DisplayName : Session.Email)
                    </span>
                }
            </div>
        </div>
    </header>

    <ClientBoot />

    <div class="relative z-10">
        <div class="@ShellClass">
            @if (IsPickerPage)
            {
                <PickerNotesPanel />
            }
            else
            {
                <SidebarApp />
            }

            <main class="min-w-0 flex-1 space-y-6">
                <PlanUsageBanner />
                <div class="space-y-6">
                    @Body
                </div>
            </main>
        </div>
    </div>

    <footer class="relative z-10 border-t border-border/60 bg-surface">
        <div class="container flex flex-col gap-4 py-6 text-sm text-foreground/70 sm:flex-row sm:items-center sm:justify-between">
            <p>© @DateTime.Now.Year BoostedRotary.com. All rights reserved.</p>
            <div class="flex items-center gap-4">
                <NavLink class="hover:text-foreground" href="/privacy">Privacy</NavLink>
                <NavLink class="hover:text-foreground" href="/terms">Terms</NavLink>
            </div>
        </div>
    </footer>
</div>

<CompareDrawer />
<ToastHost />

<div id="blazor-error-ui" class="fixed inset-x-0 bottom-4 z-50 mx-auto hidden w-[calc(100%-2rem)] max-w-md rounded-lg bg-danger/10 px-4 py-3 text-sm text-danger shadow-lg ring-1 ring-danger/30" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="ml-2 font-semibold underline underline-offset-2">Reload</a>
    <span class="dismiss ml-3 cursor-pointer text-lg leading-none">×</span>
</div>

@code {
    private bool IsPickerPage
    {
        get
        {
            var relative = Nav.ToBaseRelativePath(Nav.Uri);
            return relative.Equals("picker", StringComparison.OrdinalIgnoreCase)
                || relative.StartsWith("picker?", StringComparison.OrdinalIgnoreCase)
                || relative.StartsWith("picker/", StringComparison.OrdinalIgnoreCase);
        }
    }

    private string ShellClass => IsPickerPage
        ? "container grid gap-4 py-5 xl:grid-cols-[240px_minmax(0,1fr)] xl:items-start"
        : "container flex flex-col gap-8 py-10 md:flex-row";
}
