@rendermode InteractiveServer
@inject PickerSelectionState PickerState

<aside class="w-full shrink-0 md:w-64">
    <section class="rounded-md bg-surface p-3 shadow-sm ring-1 ring-border/60">
        <div class="flex items-center justify-between gap-2">
            <h2 class="text-sm font-bold tracking-tight">Build Notes</h2>
            <span class="text-[10px] font-semibold uppercase text-foreground/45">@NotesLength/2000</span>
        </div>
        <textarea class="mt-3 min-h-44 w-full resize-y rounded border border-border/70 bg-background px-3 py-2 text-xs leading-5 text-foreground shadow-inner outline-none focus:border-primary focus:ring-2 focus:ring-primary/20"
                  maxlength="2000"
                  placeholder="Write measurements, plans, questions, or install notes..."
                  value="@PickerState.BuildNotes"
                  @oninput="UpdateNotes"></textarea>
        <div class="mt-2 text-[11px] leading-4 text-foreground/55">
            Notes save with this picker when you save the build.
        </div>
    </section>
</aside>

@code {
    private int NotesLength => PickerState.BuildNotes?.Length ?? 0;

    private void UpdateNotes(ChangeEventArgs args)
        => PickerState.BuildNotes = args.Value?.ToString() ?? string.Empty;
}
