@page "/"
@rendermode InteractiveServer

<PageTitle>Home • BoostedRotary.com</PageTitle>

<div class="min-h-[calc(100vh-4rem)] bg-background text-foreground">
    <section class="container py-8 md:py-12">
        <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_360px] lg:items-start">
            <div class="rounded-md bg-surface p-6 shadow-sm ring-1 ring-border/60 md:p-8">
                <span class="badge">Picker-first rotary builds</span>

                <h1 class="mt-4 max-w-3xl text-balance text-3xl font-bold text-foreground md:text-5xl">
                    Build a 13B Turbo II S5 parts list one component at a time.
                </h1>

                <p class="mt-4 max-w-2xl text-pretty text-base leading-7 text-foreground/70">
                    Start with the rotary part picker, choose each component from a filtered catalog, add notes beside the build, and save the result to your builds page when you are ready.
                </p>

                <div class="mt-6 flex flex-wrap items-center gap-3">
                    <NavLink href="/picker" class="btn btn-primary">Open Picker</NavLink>
                    <NavLink href="/builds" class="btn btn-soft">View Builds</NavLink>
                </div>
            </div>

            <aside class="rounded-md bg-surface p-4 shadow-sm ring-1 ring-border/60">
                <div class="text-sm font-semibold text-foreground">Current focus</div>
                <div class="mt-3 space-y-3 text-sm text-foreground/70">
                    <div class="rounded-md bg-muted/50 p-3">
                        <div class="font-semibold text-foreground">13B Turbo II S5</div>
                        <p class="mt-1 text-pretty">The picker defaults here while other engine cores stay marked as coming soon.</p>
                    </div>
                    <div class="rounded-md bg-muted/50 p-3">
                        <div class="font-semibold text-foreground">Build notes</div>
                        <p class="mt-1 text-pretty">Keep measurements, questions, and install reminders next to the live picker.</p>
                    </div>
                    <div class="rounded-md bg-muted/50 p-3">
                        <div class="font-semibold text-foreground">Saved builds</div>
                        <p class="mt-1 text-pretty">Save a titled picker list to your account and manage it from Builds.</p>
                    </div>
                </div>
            </aside>
        </div>
    </section>
</div>
