@page "/picker/options/{EngineFamilyId:long}/{SlotId:long}/{CategorySlug}"
@rendermode InteractiveServer
@using System.Globalization
@using System.Net
@using System.Text.Json
@using System.Text.Json.Serialization
@inject HttpClient Http
@inject NavigationManager Nav
@inject PickerSelectionState PickerState

<PageTitle>Choose @ComponentName</PageTitle>

<section class="space-y-4 text-[12px]">
    <div class="-mx-4 border-y border-border/60 bg-[#56587d] px-4 py-4 text-center text-white shadow-sm md:-mx-8 md:py-5">
        <h1 class="text-xl font-bold tracking-tight text-white md:text-2xl">Choose @ComponentName</h1>
    </div>

    <div class="mx-auto grid w-full max-w-[1160px] gap-4 md:grid-cols-[190px_1fr] md:gap-6">
        <aside class="space-y-3">
            <section class="rounded-md bg-surface p-3 shadow-sm ring-1 ring-border/60 md:p-4">
                <div class="mb-3 flex items-center justify-center gap-2 text-sm font-semibold">
                    <span>Part</span>
                    @IconBox()
                    <span>List</span>
                </div>
                <label class="flex items-center gap-2 rounded border border-border/60 px-2 py-2 text-xs">
                    <input type="checkbox" checked disabled />
                    <span>Compatibility Filter</span>
                </label>
                <div class="mt-3 grid grid-cols-2 gap-3 text-[11px] font-semibold uppercase text-foreground/60">
                    <div>
                        <div>Parts</div>
                        <div class="mt-1 text-sm text-primary">@SelectedCount</div>
                    </div>
                    <div>
                        <div>Total</div>
                        <div class="mt-1 text-sm text-primary">@FormatMoney(SelectedTotal)</div>
                    </div>
                </div>
                <div class="mt-3 text-[11px] font-semibold uppercase text-foreground/60">
                    Quantity / 2 Rotor
                    <input class="mt-1 h-8 w-full rounded border border-border/70 bg-background px-2 text-xs text-foreground"
                           type="number"
                           min="1"
                           value="@Quantity"
                           @onchange="SetQuantity" />
                    <div class="mt-1 normal-case text-foreground/55">Recommended @RecommendedQty, extras allowed.</div>
                </div>
            </section>

            <details class="rounded-md bg-surface p-3 shadow-sm ring-1 ring-border/60 md:open md:bg-transparent md:p-0 md:shadow-none md:ring-0" open>
                <summary class="cursor-pointer select-none text-base font-bold md:pointer-events-none md:cursor-default">Filters</summary>
                <section class="mt-3 space-y-3 border-t border-border/60 pt-3 text-xs md:mt-0 md:border-t-0 md:pt-0">
                    <div>
                        <label class="label">Search</label>
                        <input class="input h-8 text-xs" placeholder="@ComponentName" @bind="Q" @bind:event="oninput" />
                    </div>
                    <div>
                        <label class="label">Brand</label>
                        <input class="input h-8 text-xs" placeholder="Any" @bind="Brand" @bind:event="oninput" />
                    </div>
                    <div class="grid grid-cols-2 gap-2">
                        <div>
                            <label class="label">Min $</label>
                            <input class="input h-8 text-xs" type="number" step="0.01" @bind="Min" />
                        </div>
                        <div>
                            <label class="label">Max $</label>
                            <input class="input h-8 text-xs" type="number" step="0.01" @bind="Max" />
                        </div>
                    </div>
                    <label class="flex items-center gap-2">
                        <input type="checkbox" @bind="InStock" />
                        <span>In stock only</span>
                    </label>
                    <div>
                        <label class="label">Sort</label>
                        <select class="input h-8 text-xs" @bind="Sort">
                            <option value="price">Price</option>
                            <option value="updated">Updated</option>
                        </select>
                    </div>
                    <div>
                        <label class="label">Direction</label>
                        <select class="input h-8 text-xs" @bind="Dir">
                            <option value="asc">Ascending</option>
                            <option value="desc">Descending</option>
                        </select>
                    </div>
                    <div class="flex gap-2">
                        <button class="btn btn-primary h-8 px-3 text-xs" @onclick="ApplyFiltersAsync" disabled="@IsLoading">Apply</button>
                        <button class="btn btn-ghost h-8 px-3 text-xs" @onclick="ResetFiltersAsync" disabled="@IsLoading">Reset</button>
                    </div>
                </section>
            </details>
        </aside>

        <main>
            <div class="mb-3 flex flex-wrap items-center justify-between gap-3 border-b border-border/60 pb-3">
                <div>
                    <div class="text-lg font-bold">@TotalResults Compatible Products</div>
                    <div class="text-xs text-foreground/60">@EngineCode · @CategorySlug</div>
                </div>
                <div class="flex items-center gap-2">
                    <button class="btn btn-ghost h-8 px-3 text-xs" @onclick="BackToPicker">Back to Picker</button>
                </div>
            </div>

            @if (IsLoading)
            {
                <div class="rounded-md bg-info/10 px-3 py-2 text-sm text-info ring-1 ring-info/25">Loading options...</div>
            }
            else if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="rounded-md bg-danger/10 px-3 py-2 text-sm text-danger ring-1 ring-danger/25">@ErrorMessage</div>
            }
            else
            {
                <div class="hidden overflow-x-auto sm:block">
                    <table class="w-full min-w-[860px] border-collapse text-[12px]">
                        <thead class="text-left text-[10px] font-semibold uppercase tracking-wide text-foreground/60">
                            <tr>
                                <th class="w-8 border-b border-border/60 px-2 py-2"></th>
                                <th class="border-b border-border/60 px-2 py-2">Name</th>
                                <th class="w-32 border-b border-border/60 px-2 py-2">Brand</th>
                                <th class="w-28 border-b border-border/60 px-2 py-2">Category</th>
                                <th class="w-24 border-b border-border/60 px-2 py-2">Availability</th>
                                <th class="w-24 border-b border-border/60 px-2 py-2">Unit Est.</th>
                                <th class="w-28 border-b border-border/60 px-2 py-2">Line Est.</th>
                                <th class="sticky right-0 w-16 border-b border-border/60 bg-background px-2 py-2 text-right"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var part in Rows)
                            {
                                <tr class="border-b border-border/60 hover:bg-muted/30">
                                    <td class="px-2 py-2"><input type="checkbox" /></td>
                                    <td class="px-2 py-2">
                                        <div class="flex items-center gap-2">
                                            @if (!string.IsNullOrWhiteSpace(part.image_url))
                                            {
                                                <img class="h-9 w-9 rounded border border-border/60 object-cover" src="@part.image_url" alt="" />
                                            }
                                            else
                                            {
                                                <div class="h-9 w-9 rounded border border-border/60 bg-muted"></div>
                                            }
                                            <div>
                                                <div class="font-semibold text-foreground">@part.name</div>
                                                <div class="text-[11px] text-foreground/55">@part.sku</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-2 py-2">@part.brand</td>
                                    <td class="px-2 py-2">@part.category_name</td>
                                    <td class="px-2 py-2">Compatible</td>
                                    <td class="px-2 py-2 font-semibold">@FormatMoney(part.best_price)</td>
                                    <td class="px-2 py-2 font-semibold">@FormatMoney(part.best_price.HasValue ? part.best_price.Value * Quantity : null)</td>
                                    <td class="sticky right-0 bg-background px-2 py-2 text-right">
                                        <button class="inline-flex min-h-7 min-w-[44px] items-center justify-center rounded bg-[#2f86c8] px-2.5 text-[11px] font-bold text-white shadow-sm ring-1 ring-[#1b6fa8]/30 hover:bg-[#2477b6]"
                                                @onclick="() => AddPart(part)">
                                            Add
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="space-y-2 sm:hidden">
                    @foreach (var part in Rows)
                    {
                        <article class="rounded-md bg-surface p-3 shadow-sm ring-1 ring-border/60">
                            <div class="flex gap-3">
                                @if (!string.IsNullOrWhiteSpace(part.image_url))
                                {
                                    <img class="h-14 w-14 shrink-0 rounded border border-border/60 object-cover" src="@part.image_url" alt="" />
                                }
                                else
                                {
                                    <div class="h-14 w-14 shrink-0 rounded border border-border/60 bg-muted"></div>
                                }
                                <div class="min-w-0 flex-1">
                                    <div class="font-semibold leading-snug text-foreground">@part.name</div>
                                    <div class="mt-1 text-[11px] text-foreground/55">@part.brand @(!string.IsNullOrWhiteSpace(part.sku) ? $"· {part.sku}" : string.Empty)</div>
                                    <div class="mt-1 text-[11px] text-foreground/55">@part.category_name · Compatible</div>
                                </div>
                            </div>
                            <div class="mt-3 grid grid-cols-2 gap-2 text-xs">
                                <div>
                                    <div class="text-[10px] font-semibold uppercase text-foreground/55">Unit Est.</div>
                                    <div class="font-semibold">@FormatMoney(part.best_price)</div>
                                </div>
                                <div>
                                    <div class="text-[10px] font-semibold uppercase text-foreground/55">Line Est.</div>
                                    <div class="font-semibold">@FormatMoney(part.best_price.HasValue ? part.best_price.Value * Quantity : null)</div>
                                </div>
                            </div>
                            <button class="mt-3 inline-flex h-8 w-full items-center justify-center rounded bg-[#2f86c8] px-3 text-xs font-semibold text-white shadow-sm hover:bg-[#2477b6]"
                                    @onclick="() => AddPart(part)">
                                Add
                            </button>
                        </article>
                    }
                </div>

                @if (Rows.Count == 0)
                {
                    <div class="mt-4 rounded-md bg-warning/10 px-3 py-2 text-sm text-warning ring-1 ring-warning/25">
                        No verified catalog options found for this component.
                    </div>
                }

                @if ((TotalResults > PageSize || Page > 1) && Rows.Count > 0)
                {
                    <div class="mt-4 flex items-center justify-between border-t border-border/60 pt-3 text-xs">
                        <div>Page @Page of @TotalPages</div>
                        <div class="flex gap-2">
                            <button class="btn btn-ghost h-8 px-3 text-xs" @onclick="PreviousPageAsync" disabled="@(Page <= 1 || IsLoading)">Previous</button>
                            <button class="btn btn-ghost h-8 px-3 text-xs" @onclick="NextPageAsync" disabled="@(!HasMore || IsLoading)">Next</button>
                        </div>
                    </div>
                }
            }
        </main>
    </div>
</section>

@code {
    [Parameter] public long EngineFamilyId { get; set; }
    [Parameter] public long SlotId { get; set; }
    [Parameter] public string CategorySlug { get; set; } = string.Empty;

    private readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web);
    private PickerComponent? Component { get; set; }
    private List<PartRow> Rows { get; set; } = new();
    private string EngineCode { get; set; } = string.Empty;
    private string ComponentName => Component?.category_name ?? "Parts";
    private string Q { get; set; } = string.Empty;
    private string Brand { get; set; } = string.Empty;
    private decimal? Min { get; set; }
    private decimal? Max { get; set; }
    private bool InStock { get; set; }
    private string Sort { get; set; } = "price";
    private string Dir { get; set; } = "asc";
    private int Page { get; set; } = 1;
    private int PageSize { get; set; } = 40;
    private long TotalResults { get; set; }
    private bool HasMore { get; set; }
    private bool IsLoading { get; set; }
    private string? ErrorMessage { get; set; }
    private int Quantity { get; set; } = 1;
    private int SelectedCount => PickerState.Selections.Count;
    private decimal? SelectedTotal => PickerState.Selections.Values.Any(v => v.best_price.HasValue)
        ? PickerState.Selections.Sum(selection => (selection.Value.best_price ?? 0m) * (PickerState.Quantities.TryGetValue(selection.Key, out var qty) ? Math.Max(1, qty) : 1))
        : null;
    private int TotalPages => TotalResults <= 0 ? 1 : (int)Math.Ceiling(TotalResults / (double)PageSize);
    private int RecommendedQty => Component is null ? 1 : RecommendedQuantity(Component);

    protected override async Task OnInitializedAsync()
    {
        await LoadComponentAsync();
        Quantity = PickerState.Quantities.TryGetValue(SlotId, out var quantity)
            ? Math.Max(1, quantity)
            : RecommendedQty;
        await LoadPartsAsync();
    }

    private async Task LoadComponentAsync()
    {
        var picker = await Http.GetFromJsonAsync<PickerResponse>($"/api/picker/engines/{EngineFamilyId}/components", JsonOptions);
        if (picker is null)
        {
            ErrorMessage = "Unable to load picker component.";
            return;
        }

        EngineCode = picker.engine_code;
        Component = picker.groups.SelectMany(group => group.components).FirstOrDefault(component => component.slot_id == SlotId)
            ?? picker.groups.SelectMany(group => group.components).FirstOrDefault(component => component.category_slug == CategorySlug);
        PickerState.SetEngine(EngineFamilyId, EngineCode, clearSelections: false);
    }

    private async Task LoadPartsAsync()
    {
        IsLoading = true;
        ErrorMessage = null;

        try
        {
            var query = new Dictionary<string, string?>
            {
                ["engine"] = EngineCode,
                ["category"] = CategorySlug,
                ["exclude_kits"] = "1",
                ["sort"] = Sort,
                ["dir"] = Dir,
                ["page"] = Page.ToString(CultureInfo.InvariantCulture),
                ["pageSize"] = PageSize.ToString(CultureInfo.InvariantCulture)
            };

            if (!string.IsNullOrWhiteSpace(Q)) query["q"] = Q.Trim();
            if (!string.IsNullOrWhiteSpace(Brand)) query["brand"] = Brand.Trim();
            if (Min.HasValue) query["min"] = Min.Value.ToString(CultureInfo.InvariantCulture);
            if (Max.HasValue) query["max"] = Max.Value.ToString(CultureInfo.InvariantCulture);
            if (InStock) query["in_stock"] = "1";

            var url = Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString("/api/shop", query);
            var response = await Http.GetFromJsonAsync<ShopResponse>(url, JsonOptions);
            Rows = response?.Items ?? new();
            TotalResults = response?.Total ?? 0;
            HasMore = response?.HasMore ?? false;
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Unable to load component options: {ex.Message}";
            Rows = new();
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task ApplyFiltersAsync()
    {
        Page = 1;
        await LoadPartsAsync();
    }

    private async Task ResetFiltersAsync()
    {
        Q = string.Empty;
        Brand = string.Empty;
        Min = null;
        Max = null;
        InStock = false;
        Sort = "price";
        Dir = "asc";
        Page = 1;
        await LoadPartsAsync();
    }

    private async Task PreviousPageAsync()
    {
        if (Page <= 1) return;
        Page--;
        await LoadPartsAsync();
    }

    private async Task NextPageAsync()
    {
        if (!HasMore) return;
        Page++;
        await LoadPartsAsync();
    }

    private void AddPart(PartRow part)
    {
        PickerState.SelectPart(SlotId, new PickerPartSelection
        {
            part_id = part.part_id,
            sku = part.sku,
            name = part.name,
            brand = part.brand,
            best_price = part.best_price,
            is_kit = part.is_kit,
            category_name = part.category_name,
            category_slug = part.category_slug
        }, Quantity);

        BackToPicker();
    }

    private void BackToPicker() => Nav.NavigateTo("/picker");

    private void SetQuantity(ChangeEventArgs args)
    {
        if (!int.TryParse(Convert.ToString(args.Value, CultureInfo.InvariantCulture), out var quantity))
            quantity = RecommendedQty;

        Quantity = Math.Max(1, quantity);
        PickerState.Quantities[SlotId] = Quantity;
    }

    private static string FormatMoney(decimal? value)
        => value.HasValue ? value.Value.ToString("C0", CultureInfo.GetCultureInfo("en-US")) : "--";

    private static int RecommendedQuantity(PickerComponent component)
    {
        var key = $"{component.category_slug} {component.category_name} {component.slot_name}".ToLowerInvariant();

        if (key.Contains("apex-seal-spring-big") || key.Contains("apex seal spring (big)")) return 6;
        if (key.Contains("apex-spring-small") || key.Contains("apex seal spring (small)")) return 6;
        if (key.Contains("apex-seals") || key.Contains("apex seals")) return 6;
        if (key.Contains("corner-seal-springs") || key.Contains("corner seal springs")) return 12;
        if (key.Contains("corner-seals") || key.Contains("corner seals")) return 12;
        if (key.Contains("side-seal-springs") || key.Contains("side seal springs")) return 12;
        if (key.Contains("side-seals") || key.Contains("side seals")) return 12;
        if (key.Contains("engine-dowel-pin-seal") || key.Contains("dowel pin seal")) return 4;
        if (key.Contains("engine-dowel-pin") || key.Contains("dowel pin")) return 4;
        if (key.Contains("oil-control-ring-inner-springs") || key.Contains("oil control ring inner springs")) return 4;
        if (key.Contains("oil-control-ring-outer-springs") || key.Contains("oil control ring outer springs")) return 4;
        if (key.Contains("oil-control-ring-inner") || key.Contains("oil control ring inner")) return 4;
        if (key.Contains("oil-control-ring-outer") || key.Contains("oil control ring outer")) return 4;
        if (key.Contains("rotor-bearing") || key.Contains("rotor bearing")) return 2;

        return 1;
    }

    private RenderFragment IconBox() => @<svg class="h-5 w-5 text-foreground/70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m21 8-9-5-9 5 9 5 9-5Z"/><path d="M3 8v8l9 5 9-5V8"/></svg>;

    private sealed class PickerResponse
    {
        public string engine_code { get; set; } = string.Empty;
        public List<PickerGroup> groups { get; set; } = new();
    }

    private sealed class PickerGroup
    {
        public List<PickerComponent> components { get; set; } = new();
    }

    private sealed class PickerComponent
    {
        public long slot_id { get; set; }
        public string slot_name { get; set; } = string.Empty;
        public string category_slug { get; set; } = string.Empty;
        public string category_name { get; set; } = string.Empty;
    }

    private sealed class PartRow
    {
        public long part_id { get; set; }
        public string sku { get; set; } = string.Empty;
        public string name { get; set; } = string.Empty;
        public string brand { get; set; } = string.Empty;
        public string? image_url { get; set; }
        public decimal? best_price { get; set; }
        public bool is_kit { get; set; }
        public string? category_name { get; set; }
        public string? category_slug { get; set; }
    }

    private sealed class ShopResponse
    {
        [JsonPropertyName("items")]
        public List<PartRow>? Items { get; set; }

        [JsonPropertyName("total")]
        public long Total { get; set; }

        [JsonPropertyName("has_more")]
        public bool HasMore { get; set; }
    }
}
