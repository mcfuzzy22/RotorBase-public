@page "/builder/{BuildId:long?}"
@rendermode InteractiveServer

<PageTitle>Builder Coming Soon</PageTitle>

<section class="mx-auto flex min-h-[60vh] w-full max-w-3xl items-center px-4 py-12">
    <div class="w-full rounded-md bg-surface p-6 text-center shadow-sm ring-1 ring-border/60">
        <div class="mx-auto mb-4 inline-flex h-12 w-12 items-center justify-center rounded-full bg-info/10 text-info">
            @IconWrench()
        </div>
        <h1 class="text-2xl font-bold tracking-tight text-foreground">Builder coming soon</h1>
        <p class="mx-auto mt-3 max-w-xl text-sm leading-6 text-foreground/70">
            We are focusing on the rotary part picker first. Builder support will come back after the picker flow is dialed in.
        </p>
        <div class="mt-5 flex flex-wrap justify-center gap-2">
            <a class="btn btn-primary" href="/picker">Open Picker</a>
            <a class="btn btn-ghost" href="/">Home</a>
        </div>
    </div>
</section>

@code {
    [Parameter] public long? BuildId { get; set; }

    private RenderFragment IconWrench() => @<svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a4 4 0 0 0-5 5L3 18v3h3l6.7-6.7a4 4 0 0 0 5-5l-2.4 2.4-2.8-2.8 2.2-2.6Z" /></svg>;
}
