@page "/picker"
@rendermode InteractiveServer
@using System.Globalization
@using System.Net
@using System.Text.Json
@using System.Text.Json.Serialization
@inject HttpClient Http
@inject UserSession Session
@inject NavigationManager Nav
@inject PickerSelectionState PickerState

<PageTitle>Rotary Part Picker</PageTitle>

<section class="space-y-4 text-[12px]">
    <div class="-mx-4 border-y border-[#45496d] bg-[#50547b] px-4 py-5 text-center text-white shadow-sm md:-mx-8">
        <h1 class="text-2xl font-bold tracking-tight text-white drop-shadow-sm">Choose Your Parts</h1>
    </div>

    <section class="mx-auto w-full max-w-[1100px] overflow-hidden rounded-md bg-surface shadow-sm ring-1 ring-border/60">
        <div class="grid gap-2 border-b border-border/60 bg-surface p-2.5 md:grid-cols-[1fr_auto] md:items-center">
            <div class="flex min-w-0 items-center gap-2">
                <span class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded border border-border/70 bg-muted text-primary">
                    @IconLink()
                </span>
                <input class="input min-w-0 font-mono text-xs"
                       readonly
                       value="@PickerUrl" />
            </div>
            <div class="flex flex-wrap items-end gap-2 text-xs font-semibold">
                <div class="w-44">
                    <label class="label mb-1">Engine core / family</label>
                    <select class="input h-8 text-xs" value="@SelectedEngineId" @onchange="OnEngineChangedAsync" disabled="@IsLoadingEngines">
                        @foreach (var engine in Engines)
                        {
                            <option value="@engine.engine_family_id">@engine.code</option>
                        }
                    </select>
                </div>
                <span class="badge">@SelectedCount / @ComponentCount selected</span>
                <span class="badge">Estimated cost: @FormatMoney(SelectedTotal)</span>
                <span class="badge">@NeedsCatalogCount need catalog</span>
                <button class="btn btn-primary h-8 px-3 text-xs" @onclick="OpenSaveDialog" disabled="@IsSavingBuild">
                    Save Build
                </button>
            </div>
        </div>

        <div class="@CompatibilityClass">
            <div class="flex items-center gap-2">
                @IconCheck()
                <span class="font-semibold">Compatibility:</span>
                <span>@CompatibilityText</span>
            </div>
            <div class="hidden font-semibold md:block">@SelectedEngineCode</div>
        </div>

        @if (!string.IsNullOrWhiteSpace(EngineComingSoonMessage))
        {
            <div class="border-b border-border/60 bg-info/10 px-4 py-2 text-sm font-medium text-info">
                @EngineComingSoonMessage
            </div>
        }

        @if (IsLoadingEngines || IsLoadingPicker)
        {
            <div class="p-5 text-sm text-foreground/70">Loading picker...</div>
        }
        else if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="m-4 rounded-md bg-danger/10 px-3 py-2 text-sm text-danger ring-1 ring-danger/25">@ErrorMessage</div>
        }
        else if (PickerData is null || PickerData.groups.Count == 0)
        {
            <div class="p-5 text-sm text-foreground/70">No mapped components for this engine yet.</div>
        }
        else
        {
            <div class="border-b border-border/60 bg-muted/30 px-3 py-1.5 text-xs font-medium text-foreground/65">
                Subsystems start collapsed. Click a subsystem row to expand its component list.
            </div>
            <div class="divide-y divide-border/60">
                @foreach (var group in PickerData.groups)
                {
                    var isExpanded = IsGroupExpanded(group);
                    <section class="group">
                        <button type="button"
                                class="flex w-full cursor-pointer select-none items-center justify-between gap-3 bg-surface/70 px-3 py-2 text-left text-xs font-semibold text-foreground hover:bg-muted/40"
                                aria-expanded="@isExpanded"
                                @onclick="() => ToggleGroup(group)">
                            <span class="flex items-center gap-2">
                                <span class="@ChevronClass(isExpanded)">@IconChevron()</span>
                                <span>@group.subsystem_name</span>
                            </span>
                            <span class="text-xs font-medium text-foreground/60">@(isExpanded ? "Click to collapse" : "Click to expand") · @group.components.Count components</span>
                        </button>

                        @if (isExpanded)
                        {
                        <div class="overflow-x-auto">
                            <table class="w-full min-w-[980px] border-collapse text-[11px]">
                                <thead class="bg-muted/40 text-left text-[10px] font-semibold uppercase tracking-wide text-foreground/60">
                                    <tr>
                                        <th class="w-64 border-b border-border/60 px-3 py-2">Component</th>
                                        <th class="border-b border-border/60 px-3 py-2">Selection</th>
                                        <th class="w-28 border-b border-border/60 px-3 py-2">Qty / 2 Rotor</th>
                                        <th class="w-28 border-b border-border/60 px-3 py-2">Catalog</th>
                                        <th class="w-24 border-b border-border/60 px-3 py-2">Unit Est.</th>
                                        <th class="w-32 border-b border-border/60 px-3 py-2">Estimated Cost</th>
                                        <th class="w-28 border-b border-border/60 px-3 py-2">Source</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var component in group.components)
                                    {
                                        var selected = GetSelection(component.slot_id);
                                        var recommendedQuantity = RecommendedQuantity(component);
                                        <tr class="border-b border-border/60 align-top hover:bg-muted/30">
                                            <td class="px-3 py-2">
                                                <button class="text-left font-semibold text-primary underline-offset-2 hover:underline"
                                                        @onclick="() => StartChoosingAsync(component)">
                                                    @component.category_name
                                                </button>
                                                <div class="mt-1 text-xs text-foreground/55">@component.slot_name</div>
                                            </td>
                                            <td class="px-3 py-2">
                                                @if (selected is null)
                                                {
                                                    <button type="button"
                                                            class="btn btn-primary min-h-7 min-w-[150px] px-3 text-[11px] font-bold"
                                                            @onclick="() => StartChoosingAsync(component)">
                                                        <span class="mr-1 text-sm leading-none">+</span>
                                                        Choose @component.category_name
                                                    </button>
                                                }
                                                else
                                                {
                                                    <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
                                                        <div class="flex min-w-0 items-center gap-2">
                                                            @if (!string.IsNullOrWhiteSpace(selected.image_url))
                                                            {
                                                                <img class="h-10 w-10 shrink-0 rounded border border-border/60 object-cover" src="@selected.image_url" alt="" />
                                                            }
                                                            else
                                                            {
                                                                <div class="h-10 w-10 shrink-0 rounded border border-border/60 bg-muted"></div>
                                                            }
                                                            <div class="min-w-0">
                                                                <div class="truncate font-semibold">@selected.name</div>
                                                                <div class="truncate text-xs text-foreground/60">@selected.brand @(!string.IsNullOrWhiteSpace(selected.sku) ? $"#{selected.sku}" : string.Empty)</div>
                                                            </div>
                                                        </div>
                                                        <button class="btn btn-ghost h-6 px-2 text-[11px]" @onclick="() => ClearSelection(component.slot_id)">Clear</button>
                                                    </div>
                                                }
                                            </td>
                                            <td class="px-3 py-2">
                                                <div class="flex flex-col gap-1">
                                                    <input class="h-7 w-16 rounded border border-border/70 bg-background px-2 text-xs"
                                                           type="number"
                                                           min="1"
                                                           value="@GetQuantity(component)"
                                                           @onchange="args => SetQuantity(component.slot_id, args.Value)" />
                                                    <span class="text-[10px] text-foreground/55">rec @recommendedQuantity</span>
                                                </div>
                                            </td>
                                            <td class="px-3 py-2">
                                                @if (component.candidate_count == 0)
                                                {
                                                    <span class="rounded-full bg-warning/10 px-2 py-0.5 text-xs font-semibold text-warning">needs catalog</span>
                                                }
                                                else
                                                {
                                                    <span class="text-xs text-foreground/70">@component.candidate_count options</span>
                                                }
                                            </td>
                                            <td class="px-3 py-2 font-semibold">@FormatMoney(selected?.best_price)</td>
                                            <td class="px-3 py-2 font-semibold">@FormatMoney(RowEstimatedCost(component, selected))</td>
                                            <td class="px-3 py-2">
                                                @if (selected is not null)
                                                {
                                                    <a class="text-primary underline-offset-2 hover:underline" href="@($"/shop/parts/{WebUtility.UrlEncode(selected.sku)}")">Details</a>
                                                }
                                                else
                                                {
                                                    <a class="text-primary underline-offset-2 hover:underline" href="@ShopHref(component)">Shop</a>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        }
                    </section>
                }
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(SaveMessage))
        {
            <div class="@SaveMessageClass">@SaveMessage</div>
        }
    </section>
</section>

@if (ShowSaveDialog)
{
    <div class="fixed inset-0 z-40 bg-background/60 backdrop-blur-sm"></div>
    <div class="fixed inset-0 z-50 grid place-items-center p-4">
        <section class="card w-full max-w-lg overflow-hidden shadow-xl">
            <div class="flex items-start justify-between gap-3 border-b border-border/60 px-4 py-3">
                <div>
                    <h2 class="text-lg font-semibold">Save build</h2>
                    <p class="text-sm text-foreground/60">@SelectedEngineCode · @SelectedCount selected · @FormatMoney(SelectedTotal)</p>
                </div>
                <button class="btn btn-ghost h-8 px-2" @onclick="CloseSaveDialog" aria-label="Close">x</button>
            </div>

            <div class="space-y-4 p-4">
                @if (!Session.IsSignedIn)
                {
                    <div class="rounded-md bg-warning/10 px-3 py-2 text-sm text-warning ring-1 ring-warning/25">
                        Log in or create an account to save this picker to your Builds page.
                    </div>
                    <AuthControls OpenOnMount="true" />
                }
                else
                {
                    <div>
                        <label class="label">Build title</label>
                        <input class="input" @bind="BuildTitle" @bind:event="oninput" />
                    </div>

                    @if (!string.IsNullOrWhiteSpace(SaveMessage))
                    {
                        <div class="@SaveMessageClass">@SaveMessage</div>
                    }
                }
            </div>

            <div class="flex items-center justify-end gap-2 border-t border-border/60 px-4 py-3">
                <button class="btn btn-ghost" @onclick="CloseSaveDialog" disabled="@IsSavingBuild">Cancel</button>
                <button class="btn btn-primary"
                        @onclick="SaveBuildAsync"
                        disabled="@(!Session.IsSignedIn || IsSavingBuild)">
                    @(IsSavingBuild ? "Saving..." : "Save to Builds")
                </button>
            </div>
        </section>
    </div>
}

@code {
    private const string ActiveEngineCode = "13B Turbo II S5";
    private readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web);

    private List<EngineOption> Engines { get; set; } = new();
    private PickerResponse? PickerData { get; set; }
    private long SelectedEngineId { get; set; }
    private string SelectedEngineCode => Engines.FirstOrDefault(e => e.engine_family_id == SelectedEngineId)?.code ?? PickerData?.engine_code ?? "Engine";
    private string? ErrorMessage { get; set; }
    private string? SaveMessage { get; set; }
    private string BuildTitle { get; set; } = string.Empty;
    private bool IsLoadingEngines { get; set; }
    private bool IsLoadingPicker { get; set; }
    private bool IsSavingBuild { get; set; }
    private bool SaveSucceeded { get; set; }
    private bool ShowSaveDialog { get; set; }
    private string? EngineComingSoonMessage { get; set; }

    private int ComponentCount => PickerData?.component_count ?? 0;
    private int NeedsCatalogCount => PickerData?.needs_catalog_count ?? 0;
    private Dictionary<long, PickerPartSelection> Selections => PickerState.Selections;
    private Dictionary<long, int> Quantities => PickerState.Quantities;
    private int SelectedCount => PickerState.Selections.Count;
    private decimal? SelectedTotal => PickerState.Selections.Values.Any(v => v.best_price.HasValue)
        ? PickerState.Selections.Sum(selection => (selection.Value.best_price ?? 0m) * GetQuantity(selection.Key))
        : null;
    private string PickerUrl => $"https://boostedrotary.com/picker?engine={Uri.EscapeDataString(SelectedEngineCode)}";
    private string CompatibilityText => NeedsCatalogCount == 0
        ? "No missing catalog coverage for this engine map."
        : $"{NeedsCatalogCount} components still need verified catalog parts.";
    private string CompatibilityClass => NeedsCatalogCount == 0
        ? "flex items-center justify-between gap-3 bg-success px-4 py-2 text-sm text-white"
        : "flex items-center justify-between gap-3 bg-warning px-4 py-2 text-sm text-white";
    private string SaveMessageClass => SaveSucceeded
        ? "m-4 rounded-md bg-success/10 px-3 py-2 text-sm text-success ring-1 ring-success/25"
        : "m-4 rounded-md bg-danger/10 px-3 py-2 text-sm text-danger ring-1 ring-danger/25";

    protected override async Task OnInitializedAsync()
    {
        try { await Session.HydrateAsync(); } catch { /* auth state can refresh after boot */ }
        await LoadEnginesAsync();
    }

    private async Task LoadEnginesAsync()
    {
        IsLoadingEngines = true;
        ErrorMessage = null;

        try
        {
            Engines = await Http.GetFromJsonAsync<List<EngineOption>>("/api/engine-families", JsonOptions) ?? new();
            var preferred = Engines.FirstOrDefault(e => e.code.Equals(ActiveEngineCode, StringComparison.OrdinalIgnoreCase))
                ?? Engines.FirstOrDefault(e => e.slot_count > 0)
                ?? Engines.FirstOrDefault();

            if (preferred is null)
            {
                ErrorMessage = "No engine families are available yet.";
                return;
            }

            SelectedEngineId = preferred.engine_family_id;
            BuildTitle = DefaultBuildTitle();
            PickerState.SetEngine(SelectedEngineId, SelectedEngineCode, clearSelections: false);
            await LoadPickerAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Unable to load engines: {ex.Message}";
        }
        finally
        {
            IsLoadingEngines = false;
        }
    }

    private async Task OnEngineChangedAsync(ChangeEventArgs args)
    {
        if (!long.TryParse(Convert.ToString(args.Value, CultureInfo.InvariantCulture), out var engineId) || engineId == SelectedEngineId)
            return;

        var requested = Engines.FirstOrDefault(e => e.engine_family_id == engineId);
        if (requested is null)
            return;

        if (!requested.code.Equals(ActiveEngineCode, StringComparison.OrdinalIgnoreCase))
        {
            EngineComingSoonMessage = $"{requested.code} picker support is coming soon. For now, we are focusing on {ActiveEngineCode}.";
            await InvokeAsync(StateHasChanged);
            return;
        }

        EngineComingSoonMessage = null;
        SelectedEngineId = engineId;
        PickerState.SetEngine(SelectedEngineId, SelectedEngineCode, clearSelections: true);
        BuildTitle = DefaultBuildTitle();
        await LoadPickerAsync();
    }

    private async Task LoadPickerAsync()
    {
        if (SelectedEngineId <= 0)
            return;

        IsLoadingPicker = true;
        ErrorMessage = null;

        try
        {
            PickerData = await Http.GetFromJsonAsync<PickerResponse>($"/api/picker/engines/{SelectedEngineId}/components", JsonOptions);
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Unable to load picker components: {ex.Message}";
        }
        finally
        {
            IsLoadingPicker = false;
        }
    }

    private void StartChoosingAsync(PickerComponent component)
    {
        PickerState.SetEngine(SelectedEngineId, SelectedEngineCode, clearSelections: false);
        Quantities.TryAdd(component.slot_id, RecommendedQuantity(component));
        Nav.NavigateTo($"/picker/options/{SelectedEngineId}/{component.slot_id}/{Uri.EscapeDataString(component.category_slug)}");
    }

    private bool IsGroupExpanded(PickerGroup group)
        => PickerState.ExpandedGroups.Contains(GroupKey(group));

    private void ToggleGroup(PickerGroup group)
    {
        var key = GroupKey(group);
        if (!PickerState.ExpandedGroups.Add(key))
            PickerState.ExpandedGroups.Remove(key);
    }

    private static string GroupKey(PickerGroup group)
        => group.subsystem_id.HasValue
            ? $"subsystem:{group.subsystem_id.Value}"
            : $"subsystem:{group.subsystem_key}:{group.subsystem_name}";

    private static string ChevronClass(bool isExpanded)
        => isExpanded
            ? "inline-block rotate-90 transition"
            : "inline-block transition";

    private PickerPartSelection? GetSelection(long slotId) => Selections.TryGetValue(slotId, out var part) ? part : null;
    private void ClearSelection(long slotId)
    {
        PickerState.ClearSlot(slotId);
        SaveMessage = null;
    }

    private int GetQuantity(long slotId) => Quantities.TryGetValue(slotId, out var quantity) ? Math.Max(1, quantity) : 1;

    private int GetQuantity(PickerComponent component)
        => Quantities.TryGetValue(component.slot_id, out var quantity) ? Math.Max(1, quantity) : RecommendedQuantity(component);

    private void SetQuantity(long slotId, object? value)
    {
        if (!int.TryParse(Convert.ToString(value, CultureInfo.InvariantCulture), out var quantity))
            quantity = 1;

        Quantities[slotId] = Math.Max(1, quantity);
        SaveMessage = null;
    }

    private decimal? RowEstimatedCost(PickerComponent component, PickerPartSelection? selected)
        => selected?.best_price is decimal price ? price * GetQuantity(component) : null;

    private static int RecommendedQuantity(PickerComponent component)
    {
        var key = $"{component.category_slug} {component.category_name} {component.slot_name}".ToLowerInvariant();

        if (key.Contains("apex-seal-spring-big") || key.Contains("apex seal spring (big)"))
            return 6;
        if (key.Contains("apex-spring-small") || key.Contains("apex seal spring (small)"))
            return 6;
        if (key.Contains("apex-seals") || key.Contains("apex seals"))
            return 6;
        if (key.Contains("corner-seal-springs") || key.Contains("corner seal springs"))
            return 12;
        if (key.Contains("corner-seals") || key.Contains("corner seals"))
            return 12;
        if (key.Contains("side-seal-springs") || key.Contains("side seal springs"))
            return 12;
        if (key.Contains("side-seals") || key.Contains("side seals"))
            return 12;
        if (key.Contains("engine-dowel-pin-seal") || key.Contains("dowel pin seal"))
            return 4;
        if (key.Contains("engine-dowel-pin") || key.Contains("dowel pin"))
            return 4;
        if (key.Contains("oil-control-ring-inner-springs") || key.Contains("oil control ring inner springs"))
            return 4;
        if (key.Contains("oil-control-ring-outer-springs") || key.Contains("oil control ring outer springs"))
            return 4;
        if (key.Contains("oil-control-ring-inner") || key.Contains("oil control ring inner"))
            return 4;
        if (key.Contains("oil-control-ring-outer") || key.Contains("oil control ring outer"))
            return 4;
        if (key.Contains("water-seal-jacket-inner") || key.Contains("water seal jacket inner"))
            return 4;
        if (key.Contains("water-seal-jacket-outer") || key.Contains("water seal jacket outer"))
            return 4;
        if (key.Contains("torrington-bearing") || key.Contains("torrington bearing"))
            return 2;
        if (key.Contains("rotor-bearing") || key.Contains("rotor bearing"))
            return 2;

        return 1;
    }

    private string DefaultBuildTitle()
        => $"{SelectedEngineCode} picker {DateTime.Now:yyyy-MM-dd}";

    private void OpenSaveDialog()
    {
        SaveMessage = null;
        SaveSucceeded = false;

        if (string.IsNullOrWhiteSpace(BuildTitle))
            BuildTitle = DefaultBuildTitle();

        ShowSaveDialog = true;
    }

    private void CloseSaveDialog()
    {
        if (IsSavingBuild)
            return;

        ShowSaveDialog = false;
    }

    private async Task SaveBuildAsync()
    {
        SaveMessage = null;
        SaveSucceeded = false;

        if (Selections.Count == 0)
        {
            SaveMessage = "Choose at least one component before saving.";
            return;
        }

        if (!Session.IsSignedIn)
        {
            ShowSaveDialog = true;
            return;
        }

        IsSavingBuild = true;

        try
        {
            var buildName = string.IsNullOrWhiteSpace(BuildTitle)
                ? DefaultBuildTitle()
                : BuildTitle.Trim();
            var create = await Http.PostAsJsonAsync("/api/builds", new
            {
                engine_family_id = SelectedEngineId,
                name = buildName,
                notes = PickerState.BuildNotes,
                is_archived = false,
                is_shared = false
            });

            if (!create.IsSuccessStatusCode)
            {
                SaveMessage = await BuildErrorMessageAsync(create, "Unable to create build.");
                return;
            }

            var created = await create.Content.ReadFromJsonAsync<CreateBuildResponse>(JsonOptions);
            if (created is null || created.build_id <= 0)
            {
                SaveMessage = "Build was created, but the response did not include a build id.";
                return;
            }

            var failed = 0;
            foreach (var selection in Selections)
            {
                var response = await Http.PostAsJsonAsync($"/api/builds/{created.build_id}/select", new
                {
                    slot_id = selection.Key,
                    part_id = selection.Value.part_id,
                    quantity = GetQuantity(selection.Key)
                });

                if (!response.IsSuccessStatusCode)
                    failed++;
            }

            if (failed > 0)
            {
                SaveMessage = $"Saved build {created.build_id}, but {failed} selection(s) could not be saved because of compatibility rules.";
                return;
            }

            SaveSucceeded = true;
            SaveMessage = "Build saved.";
            Nav.NavigateTo($"/builder/{created.build_id}");
        }
        catch (Exception ex)
        {
            SaveMessage = $"Unable to save build: {ex.Message}";
        }
        finally
        {
            IsSavingBuild = false;
        }
    }

    private static async Task<string> BuildErrorMessageAsync(HttpResponseMessage response, string fallback)
    {
        try
        {
            var text = await response.Content.ReadAsStringAsync();
            return string.IsNullOrWhiteSpace(text) ? fallback : $"{fallback} {text}";
        }
        catch
        {
            return fallback;
        }
    }
    private string ShopHref(PickerComponent component)
        => $"/shop?engine={Uri.EscapeDataString(SelectedEngineCode)}&category={Uri.EscapeDataString(component.category_slug)}";

    private static string FormatMoney(decimal? value)
        => value.HasValue ? value.Value.ToString("C0", CultureInfo.GetCultureInfo("en-US")) : "--";

    private RenderFragment IconLink() => @<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.1 0l2-2a5 5 0 0 0-7.1-7.1l-1.1 1.1"/><path d="M14 11a5 5 0 0 0-7.1 0l-2 2A5 5 0 0 0 12 20.1l1.1-1.1"/></svg>;
    private RenderFragment IconCheck() => @<svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>;
    private RenderFragment IconChevron() => @<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>;

    private sealed class EngineOption
    {
        public long engine_family_id { get; set; }
        public string code { get; set; } = string.Empty;
        public int slot_count { get; set; }
    }

    private sealed class PickerResponse
    {
        public long engine_family_id { get; set; }
        public string engine_code { get; set; } = string.Empty;
        public int component_count { get; set; }
        public int needs_catalog_count { get; set; }
        public List<PickerGroup> groups { get; set; } = new();
    }

    private sealed class PickerGroup
    {
        public long? subsystem_id { get; set; }
        public string subsystem_key { get; set; } = string.Empty;
        public string subsystem_name { get; set; } = string.Empty;
        public int subsystem_order { get; set; }
        public List<PickerComponent> components { get; set; } = new();
    }

    private sealed class PickerComponent
    {
        public long slot_id { get; set; }
        public string slot_key { get; set; } = string.Empty;
        public string slot_name { get; set; } = string.Empty;
        public long category_id { get; set; }
        public string category_slug { get; set; } = string.Empty;
        public string category_name { get; set; } = string.Empty;
        public long candidate_count { get; set; }
    }

    private sealed class CreateBuildResponse
    {
        public long build_id { get; set; }
    }
}
