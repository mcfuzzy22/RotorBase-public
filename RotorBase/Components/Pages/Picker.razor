@page "/picker"
@rendermode InteractiveServer
@using System.Globalization
@using System.Net
@using System.Text.Json
@using System.Text.Json.Serialization
@using Microsoft.AspNetCore.WebUtilities
@inject HttpClient Http
@inject UserSession Session
@inject NavigationManager Nav
@inject PickerSelectionState PickerState

<PageTitle>Rotary Part Picker</PageTitle>

<section class="space-y-3 text-[12px]">
    <header class="rounded-md bg-surface p-4 shadow-sm ring-1 ring-border/60">
        <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
            <div>
                <p class="text-xs font-semibold uppercase text-foreground/55">Rotary part picker</p>
                <h1 class="mt-1 text-2xl font-bold text-foreground text-balance">Choose parts for @SelectedEngineCode</h1>
                <p class="mt-1 max-w-2xl text-sm text-foreground/65 text-pretty">
                    Build a saved parts list component by component. Other engine cores are coming soon.
                </p>
            </div>
            <div class="flex flex-wrap gap-2">
                <span class="badge tabular-nums">@HandledCount / @ComponentCount handled</span>
                <span class="badge tabular-nums">Estimated cost: @FormatMoney(SelectedTotal)</span>
                <span class="badge tabular-nums">@NeedsCatalogCount need catalog</span>
            </div>
        </div>
    </header>

    <section class="w-full overflow-hidden rounded-md bg-surface shadow-sm ring-1 ring-border/60">
        <div class="grid gap-3 border-b border-border/60 bg-surface p-3 xl:grid-cols-[minmax(0,1fr)_auto] xl:items-end">
            <div class="flex min-w-0 items-center gap-2">
                <span class="inline-flex size-8 shrink-0 items-center justify-center rounded-md border border-border/70 bg-muted text-primary">
                    @IconLink()
                </span>
                <input class="input min-w-0 font-mono text-xs"
                       readonly
                       value="@PickerUrl" />
            </div>
            <div class="flex flex-wrap items-end gap-2 text-xs font-semibold">
                <div class="w-44">
                    <label class="label mb-1">Engine core / family</label>
                    <select class="input h-8 text-xs" value="@SelectedEngineId" @onchange="OnEngineChangedAsync" disabled="@IsLoadingEngines">
                        @foreach (var engine in Engines)
                        {
                            <option value="@engine.engine_family_id">@engine.code</option>
                        }
                    </select>
                </div>
                <button class="btn btn-primary h-8 px-3 text-xs" @onclick="OpenSaveDialog" disabled="@IsSavingBuild">
                    Save Build
                </button>
            </div>
        </div>

        <div class="@CompatibilityClass">
            <div class="flex items-center gap-2">
                @IconCheck()
                <span class="font-semibold">Compatibility:</span>
                <span>@CompatibilityText</span>
            </div>
            <div class="hidden font-semibold md:block">@SelectedEngineCode</div>
        </div>

        @if (!string.IsNullOrWhiteSpace(EngineComingSoonMessage))
        {
            <div class="border-b border-border/60 bg-info/10 px-4 py-2 text-sm font-medium text-info">
                @EngineComingSoonMessage
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(PickerInfoMessage))
        {
            <div class="border-b border-border/60 bg-info/10 px-4 py-2 text-sm font-medium text-info">
                @PickerInfoMessage
            </div>
        }

        @if (IsLoadingEngines || IsLoadingPicker)
        {
            <div class="p-5 text-sm text-foreground/70">Loading picker...</div>
        }
        else if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="m-4 rounded-md bg-danger/10 px-3 py-2 text-sm text-danger ring-1 ring-danger/25">@ErrorMessage</div>
        }
        else if (PickerData is null || PickerData.groups.Count == 0)
        {
            <div class="p-5 text-sm text-foreground/70">No mapped components for this engine yet.</div>
        }
        else
        {
            <div class="border-b border-border/60 bg-muted/40 px-3 py-2 text-xs font-medium text-foreground/65">
                @(IsCoreOnlyPicker
                    ? "Core starts collapsed. Open Core, choose a component, then return here with your place preserved."
                    : "Subsystems start collapsed. Open a subsystem, choose a component, then return here with your place preserved.")
            </div>
            <div class="divide-y divide-border/60">
                @foreach (var group in PickerData.groups)
                {
                    var isExpanded = IsGroupExpanded(group);
                    <section class="group">
                        <button type="button"
                                class="flex w-full cursor-pointer select-none items-center justify-between gap-3 bg-surface px-3 py-2 text-left text-xs font-semibold text-foreground transition-colors hover:bg-muted/50"
                                aria-expanded="@isExpanded"
                                @onclick="() => ToggleGroup(group)">
                            <span class="flex items-center gap-2">
                                <span class="@ChevronClass(isExpanded)">@IconChevron()</span>
                                <span>@group.subsystem_name</span>
                            </span>
                            <span class="text-xs font-medium text-foreground/60">@(isExpanded ? "Expanded" : "Collapsed") · @group.components.Count components</span>
                        </button>

                        @if (isExpanded)
                        {
                        <div class="overflow-x-auto">
                            <table class="w-full min-w-[940px] border-collapse text-[12px]">
                                <thead class="bg-muted/40 text-left text-[10px] font-semibold uppercase text-foreground/60">
                                    <tr>
                                        <th class="w-24 border-b border-border/60 px-3 py-2">Have</th>
                                        <th class="w-64 border-b border-border/60 px-3 py-2">Component</th>
                                        <th class="border-b border-border/60 px-3 py-2">Selection</th>
                                        <th class="w-28 border-b border-border/60 px-3 py-2">Qty / 2 Rotor</th>
                                        <th class="w-28 border-b border-border/60 px-3 py-2">Catalog</th>
                                        <th class="w-24 border-b border-border/60 px-3 py-2">Unit Est.</th>
                                        <th class="w-32 border-b border-border/60 px-3 py-2">Estimated Cost</th>
                                        <th class="w-28 border-b border-border/60 px-3 py-2">Source</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        var orderedComponents = OrderedComponents(group).ToList();
                                    }
                                    @for (var index = 0; index < orderedComponents.Count; index++)
                                    {
                                        var component = orderedComponents[index];
                                        var sectionName = CoreSectionName(component);
                                        var previousSectionName = index > 0 ? CoreSectionName(orderedComponents[index - 1]) : null;
                                        var selected = GetSelection(component.slot_id);
                                        var recommendedQuantity = RecommendedQuantity(component);
                                        if (IsCoreOnlyPicker && !string.Equals(sectionName, previousSectionName, StringComparison.Ordinal))
                                        {
                                            <tr>
                                                <td colspan="8" class="border-b border-border/60 bg-muted/50 px-3 py-2 text-[11px] font-bold uppercase text-foreground/65">
                                                    @sectionName
                                                </td>
                                            </tr>
                                        }
                                        <tr class="border-b border-border/60 align-top hover:bg-muted/30">
                                            <td class="px-3 py-2">
                                                <label class="inline-flex items-center gap-2 text-xs font-medium text-foreground/70">
                                                    <input type="checkbox"
                                                           checked="@IsAlreadyHave(component.slot_id)"
                                                           @onchange="args => SetAlreadyHave(component.slot_id, args.Value)" />
                                                    <span>Already have</span>
                                                </label>
                                            </td>
                                            <td class="px-3 py-2">
                                                <button class="text-left font-semibold text-primary underline-offset-2 hover:underline"
                                                        @onclick="() => StartChoosingAsync(component)">
                                                    @component.category_name
                                                </button>
                                                <div class="mt-1 text-xs text-foreground/55">@component.slot_name</div>
                                            </td>
                                            <td class="px-3 py-2">
                                                @if (IsAlreadyHave(component.slot_id))
                                                {
                                                    <div class="flex flex-wrap items-center gap-2">
                                                        <span class="rounded-full bg-success/10 px-2 py-0.5 text-xs font-semibold text-success">Already have</span>
                                                        <button class="btn btn-ghost h-6 px-2 text-[11px]" @onclick="() => ClearSelection(component.slot_id)">Clear</button>
                                                    </div>
                                                }
                                                else if (selected is null)
                                                {
                                                    <button type="button"
                                                            class="btn btn-primary h-7 min-w-24 px-3 text-[11px] font-bold"
                                                            @onclick="() => StartChoosingAsync(component)">
                                                        <span class="mr-1 text-sm leading-none">+</span>
                                                        Choose
                                                    </button>
                                                }
                                                else
                                                {
                                                    <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
                                                        <div class="flex min-w-0 items-center gap-2">
                                                            @if (!string.IsNullOrWhiteSpace(selected.image_url))
                                                            {
                                                                <img class="h-10 w-10 shrink-0 rounded border border-border/60 object-cover" src="@selected.image_url" alt="" />
                                                            }
                                                            else
                                                            {
                                                                <div class="h-10 w-10 shrink-0 rounded border border-border/60 bg-muted"></div>
                                                            }
                                                            <div class="min-w-0">
                                                                <div class="truncate font-semibold">@selected.name</div>
                                                                <div class="truncate text-xs text-foreground/60">@selected.brand @(!string.IsNullOrWhiteSpace(selected.sku) ? $"#{selected.sku}" : string.Empty)</div>
                                                            </div>
                                                        </div>
                                                        <button class="btn btn-ghost h-6 px-2 text-[11px]" @onclick="() => ClearSelection(component.slot_id)">Clear</button>
                                                    </div>
                                                }
                                            </td>
                                            <td class="px-3 py-2">
                                                <div class="flex flex-col gap-1">
                                                    <input class="h-7 w-16 rounded border border-border/70 bg-background px-2 text-xs"
                                                           type="number"
                                                           min="1"
                                                           value="@GetQuantity(component)"
                                                           @onchange="args => SetQuantity(component.slot_id, args.Value)" />
                                                    <span class="text-[10px] text-foreground/55">rec @recommendedQuantity</span>
                                                </div>
                                            </td>
                                            <td class="px-3 py-2">
                                                @if (component.candidate_count == 0)
                                                {
                                                    <span class="rounded-full bg-warning/10 px-2 py-0.5 text-xs font-semibold text-warning">needs catalog</span>
                                                }
                                                else
                                                {
                                                    <span class="text-xs text-foreground/70">@component.candidate_count options</span>
                                                }
                                            </td>
                                            <td class="px-3 py-2 font-semibold">@FormatMoney(selected?.best_price)</td>
                                            <td class="px-3 py-2 font-semibold">@FormatMoney(RowEstimatedCost(component, selected))</td>
                                            <td class="px-3 py-2">
                                                @if (selected is not null)
                                                {
                                                    <a class="btn btn-soft h-7 px-2 text-[11px]" href="@($"/shop/parts/{WebUtility.UrlEncode(selected.sku)}")">Details</a>
                                                }
                                                else
                                                {
                                                    <a class="btn btn-ghost h-7 px-2 text-[11px]" href="@ShopHref(component)">Shop</a>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        }
                    </section>
                }
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(SaveMessage))
        {
            <div class="@SaveMessageClass">@SaveMessage</div>
        }
    </section>
</section>

@if (ShowSaveDialog)
{
    <div class="fixed inset-0 z-40 bg-background/70"></div>
    <div class="fixed inset-0 z-50 grid place-items-center p-4">
        <section class="card w-full max-w-lg overflow-hidden shadow-xl">
            <div class="flex items-start justify-between gap-3 border-b border-border/60 px-4 py-3">
                <div>
                    <h2 class="text-lg font-semibold">Save build</h2>
                    <p class="text-sm text-foreground/60">@SelectedEngineCode · @HandledCount handled · @FormatMoney(SelectedTotal)</p>
                </div>
                <button class="btn btn-ghost h-8 px-2" @onclick="CloseSaveDialog" aria-label="Close">x</button>
            </div>

            <div class="space-y-4 p-4">
                @if (!Session.IsSignedIn)
                {
                    <div class="rounded-md bg-warning/10 px-3 py-2 text-sm text-warning ring-1 ring-warning/25">
                        Log in or create an account to save this picker to your Builds page.
                    </div>
                    <AuthControls OpenOnMount="true" />
                }
                else
                {
                    <div>
                        <label class="label">Build title</label>
                        <input class="input" @bind="BuildTitle" @bind:event="oninput" />
                    </div>

                    @if (!string.IsNullOrWhiteSpace(SaveMessage))
                    {
                        <div class="@SaveMessageClass">@SaveMessage</div>
                    }
                }
            </div>

            <div class="flex items-center justify-end gap-2 border-t border-border/60 px-4 py-3">
                <button class="btn btn-ghost" @onclick="CloseSaveDialog" disabled="@IsSavingBuild">Cancel</button>
                <button class="btn btn-primary"
                        @onclick="SaveBuildAsync"
                        disabled="@(!Session.IsSignedIn || IsSavingBuild)">
                    @(IsSavingBuild ? "Saving..." : "Save to Builds")
                </button>
            </div>
        </section>
    </div>
}

@code {
    private const string ActiveEngineCode = "13B Turbo II S5";
    private readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web);

    private List<EngineOption> Engines { get; set; } = new();
    private PickerResponse? PickerData { get; set; }
    private long SelectedEngineId { get; set; }
    private string SelectedEngineCode => Engines.FirstOrDefault(e => e.engine_family_id == SelectedEngineId)?.code ?? PickerData?.engine_code ?? "Engine";
    private string? ErrorMessage { get; set; }
    private string? SaveMessage { get; set; }
    private string BuildTitle { get; set; } = string.Empty;
    private bool IsLoadingEngines { get; set; }
    private bool IsLoadingPicker { get; set; }
    private bool IsSavingBuild { get; set; }
    private bool SaveSucceeded { get; set; }
    private bool ShowSaveDialog { get; set; }
    private string? EngineComingSoonMessage { get; set; }
    private string? PickerInfoMessage { get; set; }

    private int ComponentCount => PickerData?.component_count ?? 0;
    private int NeedsCatalogCount => PickerData?.needs_catalog_count ?? 0;
    private bool IsCoreOnlyPicker => PickerData?.groups.Count == 1
        && string.Equals(PickerData.groups[0].subsystem_name, "Core", StringComparison.OrdinalIgnoreCase);
    private Dictionary<long, PickerPartSelection> Selections => PickerState.Selections;
    private Dictionary<long, int> Quantities => PickerState.Quantities;
    private HashSet<long> AlreadyHaveSlots => PickerState.AlreadyHaveSlots;
    private int SelectedCount => PickerState.Selections.Count;
    private int HandledCount => PickerState.Selections.Count + PickerState.AlreadyHaveSlots.Count;
    private decimal? SelectedTotal => PickerState.Selections.Values.Any(v => v.best_price.HasValue)
        ? PickerState.Selections.Sum(selection => (selection.Value.best_price ?? 0m) * GetQuantity(selection.Key))
        : null;
    private string PickerUrl => $"https://boostedrotary.com/picker?engine={Uri.EscapeDataString(SelectedEngineCode)}";
    private string CompatibilityText => NeedsCatalogCount == 0
        ? "No missing catalog coverage for this engine map."
        : $"{NeedsCatalogCount} components still need verified catalog parts.";
    private string CompatibilityClass => NeedsCatalogCount == 0
        ? "flex items-center justify-between gap-3 border-b border-success/20 bg-success/10 px-4 py-2 text-sm text-success"
        : "flex items-center justify-between gap-3 border-b border-warning/25 bg-warning/10 px-4 py-2 text-sm text-warning";
    private string SaveMessageClass => SaveSucceeded
        ? "m-4 rounded-md bg-success/10 px-3 py-2 text-sm text-success ring-1 ring-success/25"
        : "m-4 rounded-md bg-danger/10 px-3 py-2 text-sm text-danger ring-1 ring-danger/25";

    protected override async Task OnInitializedAsync()
    {
        try { await Session.HydrateAsync(); } catch { /* auth state can refresh after boot */ }
        await LoadEnginesAsync();
    }

    private async Task LoadEnginesAsync()
    {
        IsLoadingEngines = true;
        ErrorMessage = null;

        try
        {
            Engines = await Http.GetFromJsonAsync<List<EngineOption>>("/api/engine-families", JsonOptions) ?? new();
            var preferred = Engines.FirstOrDefault(e => e.code.Equals(ActiveEngineCode, StringComparison.OrdinalIgnoreCase))
                ?? Engines.FirstOrDefault(e => e.slot_count > 0)
                ?? Engines.FirstOrDefault();

            if (preferred is null)
            {
                ErrorMessage = "No engine families are available yet.";
                return;
            }

            SelectedEngineId = preferred.engine_family_id;
            BuildTitle = DefaultBuildTitle();
            PickerState.SetEngine(SelectedEngineId, SelectedEngineCode, clearSelections: false);
            await LoadPickerAsync();
            ApplyExpandedGroupsFromQuery();

            var requestedBuildId = ReadBuildIdFromQuery();
            if (requestedBuildId.HasValue)
            {
                await LoadBuildIntoPickerAsync(requestedBuildId.Value);
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Unable to load engines: {ex.Message}";
        }
        finally
        {
            IsLoadingEngines = false;
        }
    }

    private async Task OnEngineChangedAsync(ChangeEventArgs args)
    {
        if (!long.TryParse(Convert.ToString(args.Value, CultureInfo.InvariantCulture), out var engineId) || engineId == SelectedEngineId)
            return;

        var requested = Engines.FirstOrDefault(e => e.engine_family_id == engineId);
        if (requested is null)
            return;

        if (!requested.code.Equals(ActiveEngineCode, StringComparison.OrdinalIgnoreCase))
        {
            EngineComingSoonMessage = $"{requested.code} picker support is coming soon. For now, we are focusing on {ActiveEngineCode}.";
            await InvokeAsync(StateHasChanged);
            return;
        }

        EngineComingSoonMessage = null;
        SelectedEngineId = engineId;
        PickerState.SetEngine(SelectedEngineId, SelectedEngineCode, clearSelections: true);
        BuildTitle = DefaultBuildTitle();
        await LoadPickerAsync();
    }

    private async Task LoadPickerAsync()
    {
        if (SelectedEngineId <= 0)
            return;

        IsLoadingPicker = true;
        ErrorMessage = null;

        try
        {
            PickerData = await Http.GetFromJsonAsync<PickerResponse>($"/api/picker/engines/{SelectedEngineId}/components", JsonOptions);
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Unable to load picker components: {ex.Message}";
        }
        finally
        {
            IsLoadingPicker = false;
        }
    }

    private void ApplyExpandedGroupsFromQuery()
    {
        if (PickerData is null)
            return;

        try
        {
            var uri = Nav.ToAbsoluteUri(Nav.Uri);
            var query = QueryHelpers.ParseQuery(uri.Query);
            if (!query.TryGetValue("expand", out var values))
                return;

            var requested = values
                .SelectMany(value => value?.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries) ?? Array.Empty<string>())
                .ToHashSet(StringComparer.OrdinalIgnoreCase);

            foreach (var group in PickerData.groups)
            {
                if (requested.Contains(group.subsystem_key)
                    || requested.Contains(group.subsystem_name)
                    || requested.Contains(GroupKey(group))
                    || (group.subsystem_id.HasValue && requested.Contains(group.subsystem_id.Value.ToString(CultureInfo.InvariantCulture))))
                {
                    PickerState.ExpandedGroups.Add(GroupKey(group));
                }
            }
        }
        catch
        {
            // Expansion state is convenience UI only.
        }
    }

    private async Task LoadBuildIntoPickerAsync(long buildId)
    {
        try
        {
            if (!Session.IsSignedIn)
            {
                PickerInfoMessage = "Sign in to reopen saved builds in the picker.";
                return;
            }

            var detail = await Http.GetFromJsonAsync<BuildEnvelope>($"/api/builds/{buildId}", JsonOptions);
            if (detail?.build is null)
            {
                PickerInfoMessage = "That saved build could not be loaded.";
                return;
            }

            var engine = Engines.FirstOrDefault(e => e.engine_family_id == detail.build.engine_family_id);
            if (engine is not null && !engine.code.Equals(ActiveEngineCode, StringComparison.OrdinalIgnoreCase))
            {
                EngineComingSoonMessage = $"{engine.code} picker support is coming soon. For now, we are focusing on {ActiveEngineCode}.";
                return;
            }

            if (engine is not null && engine.engine_family_id != SelectedEngineId)
            {
                SelectedEngineId = engine.engine_family_id;
                PickerState.SetEngine(SelectedEngineId, engine.code, clearSelections: true);
                await LoadPickerAsync();
            }

            PickerState.Selections.Clear();
            PickerState.Quantities.Clear();
            PickerState.AlreadyHaveSlots.Clear();
            BuildTitle = string.IsNullOrWhiteSpace(detail.build.name) ? DefaultBuildTitle() : detail.build.name!;
            PickerState.BuildNotes = detail.build.notes ?? string.Empty;

            var rows = await Http.GetFromJsonAsync<List<BuildSelectionRow>>($"/api/builds/{buildId}/selections", JsonOptions) ?? new();
            var alreadyHave = await Http.GetFromJsonAsync<AlreadyHaveResponse>($"/api/builds/{buildId}/already-have", JsonOptions);
            foreach (var slotId in alreadyHave?.slot_ids ?? new List<long>())
            {
                PickerState.AlreadyHaveSlots.Add(slotId);
            }

            if (PickerData is not null)
            {
                var slotByCategory = PickerData.groups
                    .SelectMany(group => group.components.Select(component => new { group, component }))
                    .GroupBy(item => item.component.category_id)
                    .ToDictionary(group => group.Key, group => group.First());
                var slotBySlot = PickerData.groups
                    .SelectMany(group => group.components.Select(component => new { group, component }))
                    .GroupBy(item => item.component.slot_id)
                    .ToDictionary(group => group.Key, group => group.First());

                foreach (var slotId in PickerState.AlreadyHaveSlots)
                {
                    if (slotBySlot.TryGetValue(slotId, out var match))
                        PickerState.ExpandedGroups.Add(GroupKey(match.group));
                }

                foreach (var row in rows)
                {
                    if (!slotByCategory.TryGetValue(row.category_id, out var match))
                        continue;

                    PickerState.SelectPart(match.component.slot_id, new PickerPartSelection
                    {
                        part_id = row.part_id,
                        sku = row.sku ?? string.Empty,
                        name = row.part_name ?? row.sku ?? "Saved part",
                        brand = string.Empty,
                        category_name = row.category_name ?? match.component.category_name,
                        category_slug = match.component.category_slug
                    }, DecimalQuantityToInt(row.qty));

                    PickerState.ExpandedGroups.Add(GroupKey(match.group));
                }
            }

            PickerInfoMessage = $"Loaded {BuildTitle}.";
        }
        catch (Exception ex)
        {
            PickerInfoMessage = $"Unable to load saved build: {ex.Message}";
        }
    }

    private void StartChoosingAsync(PickerComponent component)
    {
        PickerState.SetEngine(SelectedEngineId, SelectedEngineCode, clearSelections: false);
        Quantities.TryAdd(component.slot_id, RecommendedQuantity(component));
        Nav.NavigateTo($"/picker/options/{SelectedEngineId}/{component.slot_id}/{Uri.EscapeDataString(component.category_slug)}");
    }

    private bool IsGroupExpanded(PickerGroup group)
        => PickerState.ExpandedGroups.Contains(GroupKey(group));

    private void ToggleGroup(PickerGroup group)
    {
        var key = GroupKey(group);
        if (!PickerState.ExpandedGroups.Add(key))
            PickerState.ExpandedGroups.Remove(key);
    }

    private static string GroupKey(PickerGroup group)
        => group.subsystem_id.HasValue
            ? $"subsystem:{group.subsystem_id.Value}"
            : $"subsystem:{group.subsystem_key}:{group.subsystem_name}";

    private long? ReadBuildIdFromQuery()
    {
        try
        {
            var uri = Nav.ToAbsoluteUri(Nav.Uri);
            var query = QueryHelpers.ParseQuery(uri.Query);
            return query.TryGetValue("build", out var value) && long.TryParse(value.ToString(), out var buildId)
                ? buildId
                : null;
        }
        catch
        {
            return null;
        }
    }

    private static int DecimalQuantityToInt(decimal quantity)
        => Math.Max(1, (int)Math.Ceiling(quantity));

    private static string ChevronClass(bool isExpanded)
        => isExpanded
            ? "inline-block rotate-90 transition"
            : "inline-block transition";

    private PickerPartSelection? GetSelection(long slotId) => Selections.TryGetValue(slotId, out var part) ? part : null;
    private void ClearSelection(long slotId)
    {
        PickerState.ClearSlot(slotId);
        SaveMessage = null;
    }

    private bool IsAlreadyHave(long slotId) => AlreadyHaveSlots.Contains(slotId);

    private void SetAlreadyHave(long slotId, object? value)
    {
        var alreadyHave = value is bool b && b;
        PickerState.SetAlreadyHave(slotId, alreadyHave);
        SaveMessage = null;
    }

    private int GetQuantity(long slotId) => Quantities.TryGetValue(slotId, out var quantity) ? Math.Max(1, quantity) : 1;

    private int GetQuantity(PickerComponent component)
        => Quantities.TryGetValue(component.slot_id, out var quantity) ? Math.Max(1, quantity) : RecommendedQuantity(component);

    private void SetQuantity(long slotId, object? value)
    {
        if (!int.TryParse(Convert.ToString(value, CultureInfo.InvariantCulture), out var quantity))
            quantity = 1;

        Quantities[slotId] = Math.Max(1, quantity);
        SaveMessage = null;
    }

    private decimal? RowEstimatedCost(PickerComponent component, PickerPartSelection? selected)
        => selected?.best_price is decimal price ? price * GetQuantity(component) : null;

    private static int RecommendedQuantity(PickerComponent component)
    {
        var key = $"{component.category_slug} {component.category_name} {component.slot_name}".ToLowerInvariant();

        if (key.Contains("apex-seal-spring-big") || key.Contains("apex seal spring (big)"))
            return 6;
        if (key.Contains("apex-spring-small") || key.Contains("apex seal spring (small)"))
            return 6;
        if (key.Contains("apex-seals") || key.Contains("apex seals"))
            return 6;
        if (key.Contains("corner-seal-springs") || key.Contains("corner seal springs"))
            return 12;
        if (key.Contains("corner-seals") || key.Contains("corner seals"))
            return 12;
        if (key.Contains("side-seal-springs") || key.Contains("side seal springs"))
            return 12;
        if (key.Contains("side-seals") || key.Contains("side seals"))
            return 12;
        if (key.Contains("engine-dowel-pin-seal") || key.Contains("dowel pin seal"))
            return 4;
        if (key.Contains("engine-dowel-pin") || key.Contains("dowel pin"))
            return 4;
        if (key.Contains("oil-control-ring-inner-springs") || key.Contains("oil control ring inner springs"))
            return 4;
        if (key.Contains("oil-control-ring-outer-springs") || key.Contains("oil control ring outer springs"))
            return 4;
        if (key.Contains("oil-control-ring-inner") || key.Contains("oil control ring inner"))
            return 4;
        if (key.Contains("oil-control-ring-outer") || key.Contains("oil control ring outer"))
            return 4;
        if (key.Contains("water-jacket-seal-inner") || key.Contains("water jacket seal inner"))
            return 4;
        if (key.Contains("water-jacket-seal-outer") || key.Contains("water jacket seal outer"))
            return 4;
        if (key.Contains("torrington-bearing") || key.Contains("torrington bearing"))
            return 2;
        if (key.Contains("rotor-bearing") || key.Contains("rotor bearing"))
            return 2;

        return 1;
    }

    private IEnumerable<PickerComponent> OrderedComponents(PickerGroup group)
        => IsCoreOnlyPicker
            ? group.components
                .OrderBy(CoreSectionSort)
                .ThenBy(CoreItemSort)
                .ThenBy(component => component.category_name)
            : group.components;

    private static int CoreSectionSort(PickerComponent component)
    {
        var key = CoreKey(component);
        if (ContainsAny(key, "rotor-housing", "side-plate", "centre-plate", "front-rotor", "rear-rotor"))
            return 10;
        if (ContainsAny(key, "eccentric-shaft", "counter-weight", "key-weight", "eccentric-pulley", "pulley-bolt-spring", "flywheel-eccentric-nut", "endplay-spacer", "thrust-plate", "torrington-bearing"))
            return 20;
        if (ContainsAny(key, "stationary-gear", "stat-bearing", "rotor-bearing", "bearing-plate"))
            return 30;
        if (ContainsAny(key, "apex", "corner-seal", "side-seal", "oil-control-ring", "water-jacket-seal", "thermel-pellet"))
            return 40;
        if (ContainsAny(key, "oil-pump", "oil-metering"))
            return 50;
        if (ContainsAny(key, "dowel-pin"))
            return 60;
        return 90;
    }

    private static string CoreSectionName(PickerComponent component)
        => CoreSectionSort(component) switch
        {
            10 => "Housings, plates, and rotors",
            20 => "Rotating assembly",
            30 => "Stationary gears and bearings",
            40 => "Seals and springs",
            50 => "Oiling",
            60 => "Hardware",
            _ => "Other core parts"
        };

    private static int CoreItemSort(PickerComponent component)
    {
        var key = CoreKey(component);
        if (ContainsAny(key, "front-side-plate")) return 10;
        if (ContainsAny(key, "front-rotor-housing")) return 20;
        if (ContainsAny(key, "centre-plate")) return 30;
        if (ContainsAny(key, "rear-rotor-housing")) return 40;
        if (ContainsAny(key, "rear-side-plate")) return 50;
        if (ContainsAny(key, "front-rotor")) return 60;
        if (ContainsAny(key, "rear-rotor")) return 70;
        if (ContainsAny(key, "eccentric-shaft")) return 80;
        if (ContainsAny(key, "thrust-plate")) return 90;
        if (ContainsAny(key, "torrington-bearing")) return 100;
        if (ContainsAny(key, "counter-weight")) return 102;
        if (ContainsAny(key, "eccentric-pulley")) return 104;
        if (ContainsAny(key, "pulley-bolt-spring")) return 106;
        if (ContainsAny(key, "flywheel-eccentric-nut")) return 108;
        if (ContainsAny(key, "endplay-spacer")) return 109;
        if (ContainsAny(key, "apex")) return 110;
        if (ContainsAny(key, "corner-seal")) return 120;
        if (ContainsAny(key, "side-seal")) return 130;
        if (ContainsAny(key, "oil-control-ring")) return 140;
        if (ContainsAny(key, "water-jacket-seal")) return 150;
        return 500;
    }

    private static string CoreKey(PickerComponent component)
        => $"{component.category_slug} {component.category_name} {component.slot_name}".ToLowerInvariant();

    private static bool ContainsAny(string key, params string[] needles)
        => needles.Any(key.Contains);

    private string DefaultBuildTitle()
        => $"{SelectedEngineCode} picker {DateTime.Now:yyyy-MM-dd}";

    private void OpenSaveDialog()
    {
        SaveMessage = null;
        SaveSucceeded = false;

        if (string.IsNullOrWhiteSpace(BuildTitle))
            BuildTitle = DefaultBuildTitle();

        ShowSaveDialog = true;
    }

    private void CloseSaveDialog()
    {
        if (IsSavingBuild)
            return;

        ShowSaveDialog = false;
    }

    private async Task SaveBuildAsync()
    {
        SaveMessage = null;
        SaveSucceeded = false;

        if (HandledCount == 0)
        {
            SaveMessage = "Choose or mark at least one component before saving.";
            return;
        }

        if (!Session.IsSignedIn)
        {
            ShowSaveDialog = true;
            return;
        }

        IsSavingBuild = true;

        try
        {
            var buildName = string.IsNullOrWhiteSpace(BuildTitle)
                ? DefaultBuildTitle()
                : BuildTitle.Trim();
            var create = await Http.PostAsJsonAsync("/api/builds", new
            {
                engine_family_id = SelectedEngineId,
                name = buildName,
                notes = PickerState.BuildNotes,
                is_archived = false,
                is_shared = false
            });

            if (!create.IsSuccessStatusCode)
            {
                SaveMessage = await BuildErrorMessageAsync(create, "Unable to create build.");
                return;
            }

            var created = await create.Content.ReadFromJsonAsync<CreateBuildResponse>(JsonOptions);
            if (created is null || created.build_id <= 0)
            {
                SaveMessage = "Build was created, but the response did not include a build id.";
                return;
            }

            var alreadyHaveResponse = await Http.PutAsJsonAsync($"/api/builds/{created.build_id}/already-have", new
            {
                slot_ids = AlreadyHaveSlots.ToArray()
            });
            if (!alreadyHaveResponse.IsSuccessStatusCode)
            {
                SaveMessage = await BuildErrorMessageAsync(alreadyHaveResponse, "Build was created, but already-have rows could not be saved.");
                return;
            }

            var failed = 0;
            foreach (var selection in Selections)
            {
                var response = await Http.PostAsJsonAsync($"/api/builds/{created.build_id}/select", new
                {
                    slot_id = selection.Key,
                    part_id = selection.Value.part_id,
                    quantity = GetQuantity(selection.Key)
                });

                if (!response.IsSuccessStatusCode)
                    failed++;
            }

            if (failed > 0)
            {
                SaveMessage = $"Saved build {created.build_id}, but {failed} selection(s) could not be saved because of compatibility rules.";
                return;
            }

            SaveSucceeded = true;
            SaveMessage = "Build saved.";
            Nav.NavigateTo("/builds");
        }
        catch (Exception ex)
        {
            SaveMessage = $"Unable to save build: {ex.Message}";
        }
        finally
        {
            IsSavingBuild = false;
        }
    }

    private static async Task<string> BuildErrorMessageAsync(HttpResponseMessage response, string fallback)
    {
        try
        {
            var text = await response.Content.ReadAsStringAsync();
            return string.IsNullOrWhiteSpace(text) ? fallback : $"{fallback} {text}";
        }
        catch
        {
            return fallback;
        }
    }
